# TaskBrigade base configuration.
# install.sh copies this file to /etc/taskbrigade/taskbrigade.env (mode 0640, root:taskbrigade)
# when that file does not exist yet, then fills in SECRET_KEY.
# systemd loads it via EnvironmentFile. Lines starting with # are ignored.
# Change it with `sudo /opt/taskbrigade/app/.venv/bin/tbr-admin config set KEY VALUE` (checks keys and values,
# offers a restart); `tbr-admin config list` shows every setting.
# Do not put the database password here. Set it in the UI (Admin → Database) or with
# `tbr-admin set-db-password`. It is stored encrypted in $TBR_STATE_DIR/db.json.
# Docker Compose instead: copy this file to .env next to compose.yaml and fill in the
# "Docker Compose" section at the end (docs/docker.md). There the password does come from .env.
# Before TaskBrigade 0.8 the TBR_* keys were called TM_*; the old names are still read during the transition, and
# deploy/update.sh or deploy/docker/update.sh renames them in an existing file (docs/operations.md).

# Directory for master.key and db.json. Back up master.key separately from the database.
TBR_STATE_DIR=/var/lib/taskbrigade
# Directory for the tbr wheel the server delivers under /download/ (install.sh, tbr self-update).
# Empty = $TBR_STATE_DIR/dist; the checkout's dist/ (built by install.sh/update.sh) is searched too.
TBR_DIST_DIR=

# Database connection defaults. The UI can change them; the password never comes from this file.
# 3306 is MariaDB's port on a local Ubuntu install. 3307 is only an example for a remote server.
# The server must be MariaDB >= 10.5 (MySQL is not supported).
TBR_DB_HOST=127.0.0.1
TBR_DB_PORT=3306
TBR_DB_NAME=taskbrigade
TBR_DB_USER=taskadmin

# Container mode (Docker Compose): a password here makes TBR_DB_* authoritative, db.json is ignored and
# there is no setup mode. Leave empty for the native installation.
TBR_DB_PASSWORD=
# Container start: seconds to wait for the database before the container exits. Default 120.
# TBR_DB_WAIT_SECONDS=120

# Dev/test only. A full SQLAlchemy URL overrides db.json. Leave unset in production.
# DATABASE_URL=mariadb+pymysql://taskadmin:secret@127.0.0.1:3306/taskbrigade?charset=utf8mb4

# Session-signing key. install.sh replaces the empty value with a random token.
# If it stays empty, the app generates a new key on every restart and UI sessions die.
SECRET_KEY=

# Bootstrap admin, used before (and as a fallback after) the database is ready.
# Password login for the username "admin". Create the hash with:
#   sudo -u taskbrigade /opt/taskbrigade/app/.venv/bin/tbr-admin hash-password
# Paste only the hash. Restart taskbrigade after changing this file.
# Docker Compose: wrap the hash in single quotes ('$argon2id$…'), otherwise Compose expands the $ parts.
BOOTSTRAP_ADMIN_PASSWORD_HASH=
# Container start only: initial password (min. 10 characters) for BOOTSTRAP_ADMIN_ACTOR. Set once while that
# actor has no password yet; never overwrites a password changed in the UI. Remove it after the first login.
TBR_INITIAL_ADMIN_PASSWORD=
# Actor the bootstrap admin is mapped to once the database is up.
# On a new database the first migration seeds a human admin with this name (default `admin`).
# Existing installations: set this to the actor name already in the database, or the bootstrap
# login will not map onto that user.
BOOTSTRAP_ADMIN_ACTOR=admin
# Comma-separated Tailscale logins (Tailscale-User-Login) that are allowed in as admins
# when the request arrives via loopback (`tailscale serve`). Example: admin@example.org,other@example.org
UI_ALLOWED_LOGINS=
# Upgrade to schema 0005 only: owner of projects that already exist (empty = each project's creator).
DEFAULT_PROJECT_OWNER=

# Listen address read by the systemd unit. 127.0.0.1 = this host only (use tailscale serve for HTTPS).
# install.sh sets 0.0.0.0 when LAN_UI_NETWORK is passed.
TBR_BIND_HOST=127.0.0.1
# Comma-separated CIDRs that may open the UI over plain HTTP. The API stays blocked for those peers.
# Empty = loopback only. Example: 192.168.1.0/24
LAN_UI_NETWORKS=

# Comma-separated CIDRs treated like loopback (UI, API, Tailscale-User-Login, git credentials).
# Empty = loopback only. Docker Compose defaults to the bridge gateway 172.31.250.1/32 (see compose.yaml).
TRUSTED_PEER_NETWORKS=

# Comma-separated CIDRs that may use the UI and the API over plain HTTP (agents on other machines without
# Tailscale). Empty = none. API tokens then travel in cleartext – prefer Tailscale or a TLS reverse proxy.
# These peers may not send Tailscale-User-Login or fetch git credentials. Example: 192.168.1.20/32
API_NETWORKS=

# Reject clients outside loopback, TRUSTED_PEER_NETWORKS, API_NETWORKS and LAN_UI_NETWORKS. Tests set this to false. Leave unset (true) in production.
# ENFORCE_CLIENT_NETWORKS=true

# Time zone for timestamps in the UI.
TZ_DISPLAY=Europe/Berlin
# UI language: en (default) or de. Overridable under Admin → Settings and per browser (EN/DE switcher in the top bar).
UI_LANGUAGE=en

# Gitea defaults. The service token can also be stored later in the UI (Admin → Settings), which overrides these.
# install.sh probes GITEA_URL when it is not an example host (example.internal / example.com / example.org).
# A placeholder warns and continues; a real URL that does not answer GET /api/v1/version aborts install.sh.
GITEA_URL=http://gitea.example.internal:3001
# Address of the same Gitea as agents and browsers reach it: clone URLs, `tbr git-credential` (matches host and port
# exactly) and repository/PR links. Empty = GITEA_URL. Only needed when the app reaches Gitea under another name,
# e.g. Docker Compose (app: http://gitea:3000, agents: http://localhost:3000). No trailing slash.
GITEA_PUBLIC_URL=
GITEA_TOKEN=
# User or org that owns newly created project repositories. Must match a Gitea account the service token can write to.
GITEA_DEFAULT_OWNER=

# Telegram bot token (from @BotFather). Usually set in Admin → Settings instead, where the bot is also switched on;
# every human links their own chat in the profile. NOTIFY_TELEGRAM_CHAT_ID is no longer used.
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# Lease sweeper and collaborator sync. Leave unset (enabled) in production. Tests set it to false.
# SCHEDULER_ENABLED=true

# Data store (docs/data-store.md, docs/operations.md#data-zones-installation-and-migration): directory for
# encrypted datasets and the key (KEK). `deploy/install.sh`/`update.sh` create both when TBR_DATA_ZONES=1; used
# by the app only once Admin -> Settings "Data store enabled" is on.
TBR_DATA_DIR=/srv/taskbrigade-data
TBR_DATA_KEY_FILE=/etc/taskbrigade/data.key

# Opt-in data zones (concept research/konzept-datenzonen.md §9). Read by deploy/install.sh and deploy/update.sh, not
# by the app: 1 creates the system users/groups, the folder layout, the sandbox job user, the runner virtualenv
# and the polkit rule. Without it nothing changes on the system. Docker Compose: see "Data zones" below.
# TBR_DATA_ZONES=1
# SFTP inbox paths (concept §4, phase 2); only useful together with TBR_DATA_ZONES=1.
# TBR_DATA_SFTP=1
# Chroot root of the native SFTP inbox; one sub-folder <user>/upload per deliverer (tbr-admin data sftp-user).
# TBR_SFTP_DIR=/srv/taskbrigade-sftp
# Virtualenv with the pinned analysis packages for run jobs (default $TBR_BASE/runner-venv).
# TBR_RUNNER_VENV=/opt/taskbrigade/runner-venv

# Max upload size per attachment, in megabytes. Default 10.
# TBR_MAX_ATTACHMENT_MB=10

# backup.sh (systemd timer taskbrigade-backup.timer, 02:30).
# TBR_BACKUP_DIR=/var/backups/taskbrigade
# TBR_BACKUP_KEEP_DAYS=14
# With the data zones on, set TBR_BACKUP_DATA=1 to also archive the encrypted store (TBR_DATA_DIR/store) as
# ciphertext. The KEK is never part of that archive – keep backing it up separately (docs/operations.md).
# TBR_BACKUP_DATA=1

# Optional path of the env file read by the app when not using systemd. Unset = ./.env if readable.
# TBR_ENV_FILE=/etc/taskbrigade/taskbrigade.env

# --- Docker Compose (compose.yaml) ------------------------------------------------------------------
# Required: TBR_DB_PASSWORD above, MARIADB_ROOT_PASSWORD here, and an admin login
# (TBR_INITIAL_ADMIN_PASSWORD or BOOTSTRAP_ADMIN_PASSWORD_HASH). Compose sets TBR_DB_HOST, TBR_DB_PORT,
# TBR_STATE_DIR and TBR_BIND_HOST for the container itself; TBR_DB_NAME/TBR_DB_USER above name the database
# and the user that the MariaDB container creates on its first start.
MARIADB_ROOT_PASSWORD=
# Host address and port of the UI/API. Default 127.0.0.1:8090 (put tailscale serve in front).
# 0.0.0.0:8090 also serves the LAN – set LAN_UI_NETWORKS then (the API stays blocked unless API_NETWORKS).
# TBR_PUBLISH=127.0.0.1:8090
# Image to run instead of a local build, e.g. the public release image (tags <version>, <major>.<minor>, latest;
# amd64 + arm64); needs TBR_PULL_POLICY=always (default: build, image taskbrigade:local).
# TBR_IMAGE=ghcr.io/taskbrigade/taskbrigade:0.13.3
# TBR_PULL_POLICY=always
# TBR_MARIADB_IMAGE=mariadb:11.4
# Bridge network of the stack. If the range is taken, change all three together.
# TBR_DOCKER_SUBNET=172.31.250.0/24
# TBR_DOCKER_GATEWAY=172.31.250.1
# TRUSTED_PEER_NETWORKS=172.31.250.1/32
# Optional Tailscale sidecar (HTTPS and Tailscale login, docs/docker.md): enable the second compose file and
# set an auth key from the Tailscale admin console. UI_ALLOWED_LOGINS above lists who may sign in.
# COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
# TS_AUTHKEY=
# TBR_TS_HOSTNAME=taskbrigade
# TS_EXTRA_ARGS=--advertise-tags=tag:taskbrigade
# TBR_TAILSCALE_IMAGE=tailscale/tailscale:stable

# Profile "gitea" (docker compose --profile gitea up -d): bundled Gitea plus a demo project.
# GITEA_PUBLIC_URL above must match TBR_GITEA_PUBLISH (default http://localhost:3000 for 127.0.0.1:3000).
# TBR_GITEA_PUBLISH=127.0.0.1:3000
# TBR_GITEA_SSH_PUBLISH=127.0.0.1:2222
# TBR_GITEA_SSH_PORT=2222
# Gitea admin (the name "admin" is reserved in Gitea). Password default: TBR_INITIAL_ADMIN_PASSWORD.
# TBR_GITEA_ADMIN_USER=giteaadmin
# TBR_GITEA_ADMIN_PASSWORD=
# TBR_GITEA_ADMIN_EMAIL=giteaadmin@noreply.localhost
# 0 = no demo agent, project or task.
# TBR_GITEA_DEMO=1
# TaskBrigade address printed for agents by gitea-init.
# TBR_PUBLIC_URL=http://127.0.0.1:8090
# TBR_GITEA_IMAGE=gitea/gitea:1.24

# Workflow scheduler trigger: timer (native default), app (Docker default), or off.
# TBR_WORKFLOW_TICK=timer

# Data zones (docs/docker.md → Data zones): runner, launcher and sandbox job containers (profile "data"), plus the
# SFTP inbox (profile "data-sftp"). Needs Docker Engine >= 26. Both switches and the profiles together:
# TBR_DATA_ZONES=1
# TBR_DATA_SFTP=1
# COMPOSE_PROFILES=data,data-sftp
# Runner image (Dockerfile target runner; also every job container). Default: local build taskbrigade-runner:local.
# TBR_RUNNER_IMAGE=taskbrigade-runner:local
# TBR_RUNNER_PULL_POLICY=build
# Internal network of the runner (API only); the app lets this range use the API (TBR_RUNNER_NETWORKS).
# TBR_RUNNER_SUBNET=172.31.252.0/24
# RAM for the job directories (tmpfs): at least the largest dataset plus what a job writes.
# TBR_JOBS_TMPFS_SIZE=2g
# Upper bounds for the limits from Admin -> Settings -> Data runner.
# TBR_JOB_MAX_MEMORY_MB=65536
# TBR_JOB_MAX_CPU_PERCENT=3200
# Docker socket of the host, mounted into the launcher only.
# TBR_DOCKER_SOCKET=/var/run/docker.sock
# SFTP inbox address; deliverers in the LAN: 0.0.0.0:2223.
# TBR_SFTP_PUBLISH=127.0.0.1:2223
# TBR_SFTP_IMAGE=taskbrigade-sftp:local
